# Transport: "stdio" (local) or "http" (remote)
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# SearXNG instance base URL (JSON format must be enabled in its settings.yml)
SEARXNG_URL=https://search.snork.co

# Request timeout in seconds
SEARXNG_TIMEOUT=10

# Default search language, e.g. "auto", "en", "en-US"
SEARXNG_LANGUAGE=auto

# Default safe search: 0 = off, 1 = moderate, 2 = strict
SEARXNG_SAFESEARCH=1

# Optional HTTP basic auth, if your instance is behind a protected reverse proxy
SEARXNG_USERNAME=
SEARXNG_PASSWORD=

# Page fetch tool
FETCH_TIMEOUT=15
FETCH_MAX_BYTES=5000000
# Allow fetching localhost and private network addresses (keep false if serving over HTTP)
FETCH_ALLOW_PRIVATE=false
